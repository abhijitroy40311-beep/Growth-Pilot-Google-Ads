{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "growthpilot-google-ads",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/work",
      "/work/*",
      "/about-us",
      "/contact-us",
      "/faqs"
    ]
  }
}