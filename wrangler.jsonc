{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Native Worker Rate Limiting binding requires Wrangler >= 4.36.0;
  // for multi-minute production protection also enable a Cloudflare WAF Rate Limiting rule on POST /api/contact.
  "name": "growthpilot-google-ads",
  "main": "./worker.ts",
  "compatibility_date": "2025-10-01",
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/work",
      "/work/",
      "/about-us",
      "/about-us/",
      "/contact-us",
      "/contact-us/",
      "/faqs",
      "/faqs/"
    ]
  }
}
