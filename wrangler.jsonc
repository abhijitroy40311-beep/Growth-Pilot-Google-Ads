{
  "name": "growthpilot-google-ads",
  "main": "./worker.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/work",
      "/work/",
      "/about-us",
      "/about-us/",
      "/contact-us",
      "/contact-us/",
      "/faqs",
      "/faqs/"
    ]
  }
}
