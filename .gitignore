# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Production Build & Compiled Output
dist/
dist-ssr/
build/
out/
server.js
*.tsbuildinfo

# Environment Variables & Secrets (Keep .env.example tracked)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# Vite, Bundler & Tooling Caches
.vite/
.cache/
.temp/
.tmp/
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/

# Testing, Coverage & Playwright Automation
coverage/
.nyc_output/
.playwright-cli/
playwright-report/
test-results/

# AI Studio Local Artifacts
.aistudio/

# Logs & Diagnostic Reports
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDEs & Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
